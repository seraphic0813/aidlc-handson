{
  "name": "deskflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.ts *.js",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build": "vite build && tsc -p tsconfig.server.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/server/server/main.js",
    "backup": "node dist/server/server/maintenance-cli.js backup",
    "restore": "node dist/server/server/maintenance-cli.js restore",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:coverage -- --project u1-deskflow"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
